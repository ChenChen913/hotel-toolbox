{
  "name": "hotel-toolbox",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:cf": "node scripts/build-cf.mjs",
