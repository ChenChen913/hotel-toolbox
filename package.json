    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  },
  "description": "Rule-driven hotel stay toolbox: packing list, room & checkout checks, evidence-graded knowledge. No backend.",
